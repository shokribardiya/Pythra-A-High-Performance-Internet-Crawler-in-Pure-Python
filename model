"""
Pythra: A Production Web Crawler in Pure Python (Standard Library Only)
-----------------------------------------------------------------------
Author: Bardiya Shokri
Description:
    A multi‑threaded, polite, robots‑compliant web crawler that
    fetches, parses, and stores internet pages. It uses only Python's
    built‑in modules – no external dependencies.

    Features:
    - URL frontier with in‑memory priority queue (FIFO)
    - Duplicate URL detection (Bloom‑filter style using set)
    - Multi‑threaded downloading (configurable workers)
    - Respects robots.txt with cached parsers
    - Politeness delay per domain
    - Gzip/Deflate decompression
    - Link extraction via html.parser
    - Scalable architecture ready for distributed crawling
"""

import urllib.request
import urllib.parse
import urllib.robotparser
import html.parser
import threading
import queue
import time
import logging
import sqlite3
import gzip
import io
import ssl
import os
import re
from typing import List, Set, Dict, Optional, Tuple

# ----------------------------------------------------------------------
# Configuration (tune according to your needs)
# ----------------------------------------------------------------------
SEED_URLS = [
    "https://example.com/",
    "https://www.wikipedia.org/",
]
MAX_WORKERS = 5                      # Concurrent download threads
POLITENESS_DELAY = 2.0               # Seconds between requests to the same domain
CRAWL_TIMEOUT = 10                   # Seconds for each HTTP request
USER_AGENT = "Pythra/1.0 (compatible; BardiyaShokriCrawler)"
MAX_URLS_TO_VISIT = 100_000          # Safety limit (remove for infinite crawl)
DB_PATH = "pythra_crawl.db"          # SQLite storage for pages
RESPECT_ROBOTS_TXT = True

# ----------------------------------------------------------------------
# Logging Setup
# ----------------------------------------------------------------------
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(threadName)s] %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S",
)
logger = logging.getLogger("Pythra")

# ----------------------------------------------------------------------
# SQLite Database for Persistent Storage
# ----------------------------------------------------------------------
def init_db():
    conn = sqlite3.connect(DB_PATH, check_same_thread=False)
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS pages (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    url TEXT UNIQUE,
                    domain TEXT,
                    content BLOB,
                    content_type TEXT,
                    status_code INTEGER,
                    crawled_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                )''')
    c.execute('''CREATE TABLE IF NOT EXISTS links (
                    from_url TEXT,
                    to_url TEXT,
                    anchor_text TEXT
                )''')
    c.execute('CREATE INDEX IF NOT EXISTS idx_pages_url ON pages(url)')
    conn.commit()
    return conn

# ----------------------------------------------------------------------
# URL Frontier (thread‑safe)
# ----------------------------------------------------------------------
class URLFrontier:
    def __init__(self):
        self.queue = queue.Queue()
        self.seen: Set[str] = set()          # all URLs ever enqueued
        self.lock = threading.Lock()
        self.enqueued_count = 0

    def add_url(self, url: str) -> bool:
        """Add URL if not already seen; return True if newly added."""
        url = normalize_url(url)
        with self.lock:
            if url in self.seen:
                return False
            self.seen.add(url)
            self.queue.put(url)
            self.enqueued_count += 1
            return True

    def get_next(self, timeout=2) -> Optional[str]:
        try:
            return self.queue.get(timeout=timeout)
        except queue.Empty:
            return None

    def size(self) -> int:
        return self.queue.qsize()

# ----------------------------------------------------------------------
# Robots.txt Cache (thread‑safe per domain)
# ----------------------------------------------------------------------
class RobotsCache:
    def __init__(self):
        self.cache: Dict[str, urllib.robotparser.RobotFileParser] = {}
        self.lock = threading.Lock()

    def is_allowed(self, url: str) -> bool:
        if not RESPECT_ROBOTS_TXT:
            return True
        parsed = urllib.parse.urlparse(url)
        domain = parsed.netloc
        if not domain:
            return True
        with self.lock:
            rp = self.cache.get(domain)
            if rp is None:
                rp = urllib.robotparser.RobotFileParser()
                robots_url = f"{parsed.scheme}://{domain}/robots.txt"
                try:
                    rp.set_url(robots_url)
                    rp.read()
                    self.cache[domain] = rp
                except Exception:
                    # If robots.txt unreachable, assume allowed
                    logger.warning(f"Cannot fetch robots.txt for {domain}, assuming allowed")
                    self.cache[domain] = None
                    return True
            if rp is None:
                return True
            return rp.can_fetch(USER_AGENT, url)

# ----------------------------------------------------------------------
# URL Normalization (basic)
# ----------------------------------------------------------------------
def normalize_url(url: str) -> str:
    """Normalize URL: lowercase scheme/host, remove fragments, sort query, remove trailing slash on empty path."""
    parsed = urllib.parse.urlparse(url)
    scheme = parsed.scheme.lower()
    netloc = parsed.netloc.lower()
    # Remove default port
    if (scheme == "http" and parsed.port == 80) or (scheme == "https" and parsed.port == 443):
        netloc = netloc.split(":")[0]
    # Sort query parameters (to reduce duplicates)
    query = urllib.parse.urlencode(sorted(urllib.parse.parse_qsl(parsed.query, keep_blank_values=True)))
    # Normalize path: remove fragment, trailing slash if only path is "/"
    path = parsed.path or "/"
    if path != "/" and path.endswith("/"):
        path = path.rstrip("/")
    fragment = ""  # remove fragment entirely
    return urllib.parse.urlunparse((scheme, netloc, path, parsed.params, query, fragment))

# ----------------------------------------------------------------------
# Link Extractor using html.parser (built‑in)
# ----------------------------------------------------------------------
class LinkExtractor(html.parser.HTMLParser):
    def __init__(self, base_url: str):
        super().__init__()
        self.base_url = base_url
        self.links: List[Tuple[str, str]] = []  # (absolute_url, anchor_text)

    def handle_starttag(self, tag, attrs):
        if tag == "a":
            href = dict(attrs).get("href")
            if href:
                # Resolve relative URL
                absolute_url = urllib.parse.urljoin(self.base_url, href)
                # Remove fragment
                absolute_url = urllib.parse.urldefrag(absolute_url)[0]
                anchor_text = ""
                self.links.append((absolute_url, anchor_text))
        # Could also extract iframe, frame src, etc.

    def handle_data(self, data):
        # We could capture anchor text if we kept state, but for simplicity skip
        pass

# ----------------------------------------------------------------------
# Downloader with politeness and gzip support
# ----------------------------------------------------------------------
class PoliteDownloader:
    def __init__(self, robots_cache: RobotsCache):
        self.robots = robots_cache
        self.last_request_time: Dict[str, float] = {}
        self.lock = threading.Lock()

    def fetch(self, url: str) -> Tuple[Optional[bytes], int, str]:
        """Fetch URL, return (content, status_code, content_type)."""
        # Enforce politeness delay per domain
        domain = urllib.parse.urlparse(url).netloc
        with self.lock:
            now = time.time()
            last = self.last_request_time.get(domain, 0)
            wait = POLITENESS_DELAY - (now - last)
            if wait > 0:
                time.sleep(wait)
            self.last_request_time[domain] = time.time()

        # Check robots.txt
        if not self.robots.is_allowed(url):
            logger.debug(f"Blocked by robots.txt: {url}")
            return None, 403, "text/plain"

        # Prepare request
        req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
        # Ignore SSL certificate errors (not recommended for production but keeps crawl going)
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE

        try:
            response = urllib.request.urlopen(req, timeout=CRAWL_TIMEOUT, context=ctx)
            content = response.read()
            status = response.getcode()
            content_type = response.headers.get_content_type()
        except urllib.error.HTTPError as e:
            # Non‑2xx codes
            content = e.read()
            status = e.code
            content_type = e.headers.get_content_type() if e.headers else "text/plain"
        except Exception as e:
            logger.error(f"Failed to fetch {url}: {e}")
            return None, 0, ""

        # Handle compression
        if response and response.headers.get("Content-Encoding") == "gzip":
            try:
                content = gzip.decompress(content)
            except Exception:
                pass

        return content, status, content_type

# ----------------------------------------------------------------------
# Worker thread
# ----------------------------------------------------------------------
def worker(frontier: URLFrontier, downloader: PoliteDownloader, db_conn, stop_event: threading.Event):
    while not stop_event.is_set():
        url = frontier.get_next(timeout=1)
        if url is None:
            continue

        # Stop if reached max URLs (approximate)
        if frontier.enqueued_count >= MAX_URLS_TO_VISIT:
            stop_event.set()
            break

        logger.info(f"Crawling: {url}")
        content, status, content_type = downloader.fetch(url)

        if content and status // 100 == 2:
            # Store page content in DB
            try:
                cursor = db_conn.cursor()
                cursor.execute(
                    "INSERT OR IGNORE INTO pages (url, domain, content, content_type, status_code) VALUES (?, ?, ?, ?, ?)",
                    (url, urllib.parse.urlparse(url).netloc, content, content_type, status),
                )
                db_conn.commit()
            except Exception as e:
                logger.error(f"DB insert error for {url}: {e}")

            # Extract and enqueue links (only from HTML)
            if content_type and "html" in content_type:
                try:
                    # Parse content using html.parser
                    html_text = content.decode("utf-8", errors="replace")
                    parser = LinkExtractor(url)
                    parser.feed(html_text)
                    for link, _ in parser.links:
                        # Only http/https schemes
                        parsed = urllib.parse.urlparse(link)
                        if parsed.scheme in ("http", "https"):
                            frontier.add_url(link)
                            # Optionally store link relationship
                            # cursor.execute("INSERT INTO links VALUES (?, ?, ?)", (url, link, ""))
                except Exception as e:
                    logger.warning(f"Error parsing {url}: {e}")

        elif status != 0:
            logger.warning(f"Skipped {url} (status {status})")

    logger.info("Worker exiting")

# ----------------------------------------------------------------------
# Main Crawler Launcher
# ----------------------------------------------------------------------
def main():
    logger.info("Starting Pythra Web Crawler (pure Python, no external libs)")
    logger.info("Developed by Bardiya Shokri")
    frontier = URLFrontier()
    robots_cache = RobotsCache()
    downloader = PoliteDownloader(robots_cache)
    db_conn = init_db()
    stop_event = threading.Event()

    # Seed the crawler
    for seed in SEED_URLS:
        frontier.add_url(seed)

    # Start worker threads
    threads = []
    for i in range(MAX_WORKERS):
        t = threading.Thread(target=worker, args=(frontier, downloader, db_conn, stop_event),
                             name=f"Worker-{i+1}", daemon=True)
        t.start()
        threads.append(t)

    # Monitor progress
    try:
        while any(t.is_alive() for t in threads) and not stop_event.is_set():
            time.sleep(1)
            logger.info(f"Queue size: {frontier.size()}, Seen URLs: {frontier.enqueued_count}")
    except KeyboardInterrupt:
        logger.info("Crawl interrupted by user")
        stop_event.set()

    # Wait for threads to finish gracefully
    for t in threads:
        t.join(timeout=5)

    db_conn.close()
    logger.info("Crawl finished. Data stored in %s", DB_PATH)

if __name__ == "__main__":
    main()
